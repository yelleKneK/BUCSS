Package: BUCSS
Type: Package
Title: Bias and Uncertainty Corrected Sample Size
Version: 2.0.0
Date: 2026-09-30
Authors@R: c(
    person("Ken", "Kelley", role = c("aut", "cre"),
           email = "kkelley@nd.edu",
           comment = c(ORCID = "0000-0002-4756-8360")),
    person("Samantha F.", "Anderson", role = "aut",
           email = "samantha.f.anderson@asu.edu",
